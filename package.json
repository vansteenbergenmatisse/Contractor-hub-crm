{
  "name": "contractor-hub-crm",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "admin:create": "tsx scripts/create-admin.ts",
    "test:pg": "RUN_PG_TESTS=1 vitest run tests/features/auth/invites-db.pg.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "postinstall": "prisma generate"
  },
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "@neon/config": "^1.14.5",
    "@neon/env": "^2.1.8",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "1.7.26",
    "crypto-js": "4.2.0",
    "dotenv": "^18.0.10",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
