# Same names in every environment (develop, staging, production). Values differ per Neon branch.
# Real values go in .env.local (gitignored) or the host/CI secret store. Never commit them.

# Pooled connection (host contains -pooler). App runtime only.
DATABASE_URL=""

# Direct connection (no -pooler). Prisma CLI only: migrate, db push, studio.
DATABASE_URL_UNPOOLED=""

# --- App and sign-in (group "auth"). Set per environment in Vercel. ---
APP_URL=""
BETTER_AUTH_URL=""
BETTER_AUTH_SECRET=""

# --- HighLevel (group "highlevel"). Live app in production, Test app in staging and dev. ---
GHL_APP_ID=""
GHL_CLIENT_ID=""
GHL_CLIENT_SECRET=""
GHL_APP_SHARED_SECRET=""
# "Sign in with HighLevel" on /sign-in (optional, not secret). The CRM menu page's address copied from
# the browser with the sub-account id replaced by {locationId}, for example
# https://<highlevel-host>/<path-with>/{locationId}/<rest>. Unset: the button opens HighLevel's app home.
HIGHLEVEL_CRM_MENU_URL=""
GHL_REDIRECT_URI=""
GHL_API_BASE_URL=""
GHL_INSTALL_BASE_URL=""
# Key for AES-256-GCM token encryption (32 bytes, base64). Never reuse across environments.
TOKEN_ENCRYPTION_KEY=""
# Optional. Draft Marketplace app version id: added to the install URL as version_id. Leave empty
# for a published app.
GHL_APP_VERSION_ID=""
# Optional. Space separated scopes that replace the default list in src/features/highlevel/api/scopes.ts.
GHL_OAUTH_SCOPES=""

# --- Onboarding (sub-account sync, user accounts, email) ---
# Bearer secret for POST/GET /api/integrations/sync (Vercel daily cron). Vercel
# sends it automatically to its cron when this variable exists. Generate with: openssl rand -base64 32
CRON_SECRET=""
# Where the "sub-accounts without the CRM app" alert goes.
ADMIN_ALERT_EMAIL=""
# Resend (transactional email). Both needed, otherwise no mail is sent (log only). Setting them does
# not send mail on its own: EMAIL_DELIVERY_MODE must also allow it.
RESEND_API_KEY=""
EMAIL_FROM=""
# "log" (the default, also used for any unknown value) sends nothing. "allowlist" sends only to the
# exact addresses in EMAIL_ALLOWED_RECIPIENTS (comma separated, no wildcard). "live" sends to anyone.
EMAIL_DELIVERY_MODE=""
EMAIL_ALLOWED_RECIPIENTS=""
# Slack incoming webhook for internal failed-send alerts. Empty means off. Treat it as a secret.
SLACK_FAILED_SEND_WEBHOOK_URL=""
# "true" lets onboarding mail the "set your password" link to every new user it creates. Anything
# else (the default) creates the accounts but sends nothing: keep it off while a real client such as
# JCR Landscaping is the test sub-account.
ONBOARDING_SEND_SET_PASSWORD=""

# Extra image hosts (comma separated) the home-screen icon may fetch client logos from. The default
# is HighLevel's media host assets.cdn.filesafe.space.
LOGO_HOST_ALLOWLIST=""

# Optional server kill switches. Set to "true" to turn the feature off.
CLIENT_VIEW_DISABLED=""
# Turns off the Leads page read and the leads CSV export.
LEADS_READ_DISABLED=""
INBOX_READ_DISABLED=""
PIPELINE_READ_DISABLED=""
CALENDAR_READ_DISABLED=""
AUTOMATIONS_READ_DISABLED=""
QUOTES_READ_DISABLED=""
INVOICES_READ_DISABLED=""
PAYMENTS_READ_DISABLED=""

# Server-only page flags. They stay off until a real response confirms amount units and list fields.
QUOTES_PAGE_LIVE=""
INVOICES_PAGE_LIVE=""
PAYMENTS_PAGE_LIVE=""
AUTOMATIONS_PAGE_LIVE=""

# Settings write-back to HighLevel custom values. Off unless ENABLED is exactly "true" AND the tenant
# id is in the comma-separated list. No wildcard. Clear ENABLED to stop all writes at once.
SETTINGS_WRITE_BACK_ENABLED=""
SETTINGS_WRITE_BACK_TENANTS=""

# Routes "Notify the client when you start". Off unless ENABLED is exactly "true" AND the tenant id is
# in the comma-separated list. No wildcard. Clear ENABLED to stop all notifications at once.
ROUTES_NOTIFY_ENABLED=""
ROUTES_NOTIFY_TENANTS=""

# Settings Change image (new file in the HighLevel media library, then the custom value points at it).
# Off unless ENABLED is exactly "true" AND the exact tenant id is in the comma-separated list. No
# wildcard. It also needs the write-back flags above and the medias scopes approved on the app.
SETTINGS_MEDIA_REPLACE_ENABLED=""
SETTINGS_MEDIA_REPLACE_TENANTS=""

# Admin "Copy values from template" on /admin/clients (docs/onboarding.md). Off unless ENABLED is
# exactly "true" AND TEMPLATE_TENANT_ID is the CRM tenant id of the template sub-account (copy it from
# the clients table). The template is read only; the client is written with its own token.
TEMPLATE_COPY_ENABLED=""
TEMPLATE_TENANT_ID="<crm-tenant-id-of-template>"

# Create a real contact from New lead. Off unless ENABLED is exactly "true" AND the exact tenant id is
# in the comma-separated list. No wildcard. While off, a lead typed in stays on screen and is not saved.
LEADS_CREATE_ENABLED=""
LEADS_CREATE_TENANTS=""

# Server key for address search (Google Places API (New) Autocomplete). Empty: a plain address field.
GOOGLE_MAPS_SERVER_KEY=""
