# Same names in every environment (develop, staging, production). Values differ per Neon branch.
# Real values go in .env.local (gitignored) or the host/CI secret store. Never commit them.

# Pooled connection (host contains -pooler). App runtime only.
DATABASE_URL=""

# Direct connection (no -pooler). Prisma CLI only: migrate, db push, studio.
DATABASE_URL_UNPOOLED=""

# --- App and sign-in (group "auth"). Set per environment in Vercel. ---
APP_URL=""
BETTER_AUTH_URL=""
BETTER_AUTH_SECRET=""

# --- HighLevel (group "highlevel"). Live app in production, Test app in staging and dev. ---
GHL_APP_ID=""
GHL_CLIENT_ID=""
GHL_CLIENT_SECRET=""
GHL_APP_SHARED_SECRET=""
GHL_REDIRECT_URI=""
GHL_API_BASE_URL=""
GHL_INSTALL_BASE_URL=""
# Key for AES-256-GCM token encryption (32 bytes, base64). Never reuse across environments.
TOKEN_ENCRYPTION_KEY=""
# Optional. Draft Marketplace app version id: added to the install URL as version_id. Leave empty
# for a published app.
GHL_APP_VERSION_ID=""
# Optional. Space separated scopes that replace the default list in src/features/highlevel/api/scopes.ts.
GHL_OAUTH_SCOPES=""

# --- Onboarding (sub-account sync, user accounts, email) ---
# Bearer secret for POST/GET /api/integrations/sync (n8n every 10 minutes, Vercel daily cron). Vercel
# sends it automatically to its cron when this variable exists. Generate with: openssl rand -base64 32
CRON_SECRET=""
# Where the "sub-accounts without the CRM app" alert goes.
ADMIN_ALERT_EMAIL=""
# Resend (transactional email). Both needed, otherwise no mail is sent (log only).
RESEND_API_KEY=""
EMAIL_FROM=""
# "true" lets onboarding mail the "set your password" link to every new user it creates. Anything
# else (the default) creates the accounts but sends nothing: keep it off while a real client such as
# JCR Landscaping is the test sub-account.
ONBOARDING_SEND_SET_PASSWORD=""

# Extra image hosts (comma separated) the home-screen icon may fetch client logos from. The default
# is HighLevel's media host assets.cdn.filesafe.space.
LOGO_HOST_ALLOWLIST=""
