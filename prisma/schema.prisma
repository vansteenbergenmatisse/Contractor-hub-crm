// One schema file. Add a commented section per feature, e.g. "// ---- feature: today ----".
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---- feature: tenants ----
// One client company, linked to one HighLevel sub-account (location). Every row of tenant data
// carries a tenantId; the tenant is resolved from the server session, never from the browser.

enum TenantStatus {
  connected
  needs_reconnect
  uninstalled
}

model Tenant {
  id            String                @id @default(cuid())
  name          String?
  locationId    String                @unique
  companyId     String?
  status        TenantStatus          @default(connected)
  uninstalledAt DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  connection    HlLocationConnection?
  webhookEvents WebhookEvent[]
  users         User[]
  invites       Invite[]
  syncState     TenantSyncState?
  loginLock     TenantLoginLock?
}

// "Turn off login" for a whole client. A row means login is off; no row (the default) means on.
// While it exists, no path creates or admits a user of this tenant (password, embed, provisioning,
// invite). Admins have no tenant. A separate table so the Tenant table is not altered.
model TenantLoginLock {
  tenantId   String   @id
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  disabledAt DateTime @default(now())
}

// ---- feature: highlevel ----
// Tokens are stored encrypted (AES-256-GCM, see src/shared/lib/encryption.ts). Never plaintext.

model HlAgencyConnection {
  id              String   @id @default(cuid())
  companyId       String   @unique
  accessTokenEnc  String
  refreshTokenEnc String
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model HlLocationConnection {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationId      String   @unique
  accessTokenEnc  String
  // HighLevel's v3 location-token response includes a refresh token; if one is missing the
  // token service re-mints from the agency token.
  refreshTokenEnc String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// One row per delivered webhook; webhookId makes processing idempotent.
// tenantId is resolved server-side from the verified payload (null for agency-level events).
// The payload can hold personal data (contacts, messages): retention is an open decision, see
// PROGRESS.md. receivedAt is indexed so a purge job can delete old rows.
model WebhookEvent {
  id          String    @id @default(cuid())
  webhookId   String    @unique
  type        String
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  locationId  String?
  companyId   String?
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([locationId])
  @@index([tenantId])
  @@index([receivedAt])
}

// ---- feature: auth ----
// Better Auth tables (email and password, invite only) plus our invites. The model and field names
// follow Better Auth's schema; five fields are renamed through `fields` in
// src/features/auth/api/auth.ts so that none of them is named like a provider token (the
// "token fields end in Enc" test): Session.sessionKey, Account.oauthAccess, oauthRefresh, oauthId
// and their expiry columns. The Account columns stay empty (no social login). Better Auth keeps the
// session key in clear in its table, as designed; the cookie carrying it is signed.

enum UserRole {
  owner
  office
  admin
}

model User {
  id             String    @id
  name           String
  email          String    @unique
  emailVerified  Boolean   @default(false)
  image          String?
  // Server-only (Better Auth `input: false`). Owner and office belong to one tenant; admin is
  // Forge Forward staff and has none (checked in createInvitedUser).
  role           UserRole  @default(owner)
  tenantId       String?
  tenant         Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // "Turn off login": set by an admin, blocks sign-in and ends the sessions.
  disabledAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  sessions       Session[]
  accounts       Account[]
  invitesCreated Invite[]
  unusedMarker   UnusedAccountMarker?

  @@index([tenantId])
}

// Exists only while an account is provably never used (docs/onboarding.md, decision 3). Written when
// the sync creates the account, deleted by the session-create hook or by a move. `credentialFingerprint`
// is a SHA-256 of the first password hash, so a password that was set shows up as a mismatch. No row
// means "counts as used": such an account is never moved to another client.
model UnusedAccountMarker {
  userId                String   @id
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId              String
  credentialFingerprint String
  createdAt             DateTime @default(now())
}

model Session {
  id         String   @id
  expiresAt  DateTime
  sessionKey String   @unique
  ipAddress  String?
  userAgent  String?
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthAccess           String?
  oauthRefresh          String?
  oauthId               String?
  oauthAccessExpiresAt  DateTime?
  oauthRefreshExpiresAt DateTime?
  scope                 String?
  // Password hash (scrypt, made by Better Auth). Never the password.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

// Better Auth rate limiting kept in the database (serverless instances share no memory).
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

// One invite = one future user of one tenant. Only the SHA-256 of the single-use code is stored;
// the code itself travels in the invite link and is never logged.
model Invite {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Lower-cased email, checked against the tenant's HighLevel users before the invite is created.
  email       String
  role        UserRole
  hlUserId    String
  codeHash    String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([tenantId])
  @@index([email])
}

// ---- feature: onboarding ----
// One row per HighLevel user we created or matched a CRM user for, so a sync can find, update and
// deactivate the CRM user without touching the User table. `deletedAt` is set when HighLevel no
// longer lists the user in that sub-account.
model GhlUserLink {
  id        String    @id @default(cuid())
  tenantId  String
  ghlUserId String
  userId    String    @unique
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([tenantId, ghlUserId])
  @@index([tenantId])
}

// A sub-account that has no app installed. The sync alerts an admin about it at most once per
// 24 hours, so a repeated sync does not send a mail every run.
model MissingAppAlert {
  locationId    String   @id
  companyId     String
  name          String?
  firstSeenAt   DateTime @default(now())
  lastAlertedAt DateTime
}

// When a tenant's on-visit user sync was last claimed, and how many set-password mails it was sent
// on `mailDay` (UTC). A separate table so that both are atomic row updates across server instances
// and the Tenant table is not altered.
model TenantSyncState {
  tenantId      String    @id
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lastClaimedAt DateTime?
  mailDay       DateTime? @db.Date
  mailCount     Int       @default(0)
}

// ---- feature: mailbox-prompt ----
// One row when this user dismissed the "check your mailbox" card in this tenant. No row means the
// card may show. It says nothing about whether a mailbox is connected: HighLevel does not expose that.
// No relations, so the User and Tenant models stay untouched.
model MailboxPromptDismissal {
  userId      String
  tenantId    String
  dismissedAt DateTime @default(now())

  @@id([userId, tenantId])
}

// ---- feature: brand ----
// A client's personal sign-in link (/sign-in?client=<slug>). Cosmetic only: it picks the branding of
// the signed-out page and grants nothing. The slug stays the same when the business name changes.
// No relation, so the Tenant model stays untouched.
model TenantSignInLink {
  tenantId  String   @id
  slug      String   @unique
  createdAt DateTime @default(now())
}

// ---- feature: settings ----
// One row per custom value the app tried to change in a client's HighLevel sub-account: who, what,
// the value before (for undo) and the outcome. Written as "pending" before HighLevel is called.
// No relations, so an audit row outlives the user or tenant it names.
model CustomValueChange {
  id            String    @id @default(cuid())
  tenantId      String
  actorId       String
  key           String
  previousValue String
  newValue      String
  outcome       String    @default("pending")
  createdAt     DateTime  @default(now())
  finishedAt    DateTime?

  @@index([tenantId, createdAt])
}

// One Settings save per tenant at a time. A short lease: an expired row can be taken over.
model CustomValueSaveLock {
  tenantId  String   @id
  holder    String
  expiresAt DateTime
}

// ---- feature: routes ----

// One "on my way" trigger per appointment. Written as "pending" before HighLevel is called, so a repeat
// tap, a reload or a second crew member can never fire it again. Outcome: pending, notified, failed or
// unconfirmed. No relations, so the record outlives the user or tenant it names.
model RouteStartNotification {
  id            String    @id @default(cuid())
  tenantId      String
  appointmentId String
  actorId       String
  outcome       String    @default("pending")
  createdAt     DateTime  @default(now())
  finishedAt    DateTime?

  @@unique([tenantId, appointmentId])
}
